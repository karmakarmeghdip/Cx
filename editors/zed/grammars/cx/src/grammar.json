            "type": "PATTERN",
            "value": "0[bB][01']+(wb|uwb|WB|UWB)?"
          },
          {
            "type": "PATTERN",
            "value": "0[xX][0-9a-fA-F']+([uU]*[lL]{0,2})?"
          },
          {
            "type": "PATTERN",
            "value": "0[0-7']*([uU]*[lL]{0,2})?"
          },
          {
            "type": "PATTERN",
            "value": "[0-9][\\d']*(\\.[\\d']*)?([eE][+-]?[\\d']+)?[fFlL]?[uU]*[lL]{0,2}"
          },
          {
            "type": "PATTERN",
            "value": "[0-9][\\d']*(wb|uwb|WB|UWB)"
          }
        ]
      }
