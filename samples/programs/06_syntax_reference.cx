/* Definitions */
[[nodiscard]] function checked_value(value: int): int
{
    return value < 0 ? -value : value;
}

function unnamed_parameters(int, char*): int
{
    return 0;
}

function variadic_only(...): void {}

static function function_with_attributes(value: int): int
{
    return value;
}

static _Noreturn function terminate_now(): void
{
    exit(1);
}

static function returns_pointer(selector: int): int*
{
    static let first: int;
    static let second: int;
    return selector ? &first : &second;
}

static function returns_array_pointer(): int[4]*
{
    static let array: int[2][4];
    return array;
}

static function callback_body(value: int): void
{
    value as void;
}

static function takes_callback(callback: ((int) => void)*): ((int) => void)*
{
    return callback;
}

static function add(left: int, right: int): int
{
    return left + right;
}

static function pointer_parameter(values: int*, count: size_t): int
{
    let total: int = 0;
    while (count-- != 0) {
        total += *values++;
    }
    return total;
}

static function qualified_pointer_parameter(values: const int* restrict, count: size_t): int
{
    return count == 0 ? 0 : values[0];
}

static function array_parameter(values: int[WIDTH]): int
{
    return values[WIDTH - 1];
}

static function qualified_array_parameter(values: int[const WIDTH]): int
{
    return values[0];
}

static function static_array_parameter(values: int[static WIDTH]): int
{
    return values[0];
}

static function variable_array_parameter(count: int, values: int[count]): size_t
{
    values as void;
    return count as size_t;
}

static function matrix_parameter(count: int, values: int[count][3]): int
{
    let total: int = 0;
    for (let row: int = 0; row < count; ++row) {
        total += values[row][2];
    }
    return total;
}

static function apply_operation(left: int, right: int, operation: ((int, int) => int)*): int
{
    return operation(left, right);
}

static function generic_identity(value: const int*): int
{
    return _Generic(value,
        int*: 1,
        const int*: 2,
        default: 0);
}

static function collect_varargs(count: int, ...): size_t
{
    let arguments: va_list;
    va_start(arguments, count);
    let total: int = 0;
    for (let index: int = 0; index < count; ++index) {
        total += va_arg(arguments, int);
    }
    va_end(arguments);
    return total as size_t;
}

static function c23_varargs(first: int, ...): int
{
    let arguments: va_list;
    va_start(arguments);
    let second: int = va_arg(arguments, int);
    va_end(arguments);
    return first + second;
}

static function static_compound_literal(): int*
{
    static let values: int[] = [3, 4];
    return values;
}

static function statement_expressions(seed: int): void
{
    let value: int = seed;

    if (value < 0) {
        value = -value;
    } else if (value == 0) {
        value = 1;
    } else {
        value--;
    }

    switch (value % 3) {
    case 0:
        value += 3;
        break;
    case 1:
        value -= 1;
        [[fallthrough]];
    case 2:
        value *= 2;
        break;
    default:
        value = 0;
    }

    while (value < 10) {
        ++value;
    }

    do {
        --value;
    } while (value > 0);

    for (let index: int = 0; index < 3; ++index) {
        if (index == 1) {
            continue;
        }
        value += index;
    }

    for (;;) {
        break;
    }

    if (value == 0) {
        goto done;
    }

done:
    ;
}

static function c23_label_placement(value: int): int
{
    goto negative;

negative:
    let result: int = -value;
    if (result > 10) {
        goto finished;
    }
    ++result;

finished:
    return result;
}

static function empty_label_at_block_end(): void
{
    goto finished;
finished:
}

/* Expression productions */
static function expression_productions(): void
{
    let values: int[WIDTH] = [1, 2, 3, 4];
    let pointer: int* = values;
    let pointer_to_pointer: int** = &pointer;
    let array_pointer: int[WIDTH]* = &values;
    let pointer_element: int = values[2];
    let function_pointer_value: ((int, char*) => int)* = NULL;
    let text: const char* = "Cx";
    let before_increment: int = pointer_element++;
    let after_increment: int = ++pointer_element;
    let negative: int = -before_increment;
    let positive: int = +negative;
    let logical_not: int = !after_increment;
    let bit_not: int = ~after_increment;
    let distance: ptrdiff_t = pointer + WIDTH - pointer;
    let comparison: bool = 0 < after_increment && after_increment <= WIDTH;
    let bit_value: int = (0x0f & 0x33) | (0x10 ^ 0x01);
    bit_value <<= 1;
    bit_value >>= 1;
    let conditional: int = comparison ? bit_value : 0;
    let comma: int = (conditional++, conditional + 1);
    let type_size: size_t = sizeof(struct point);
    let expression_size: size_t = sizeof(values);
    let unevaluated_size: size_t = sizeof(pointer_element);
    let alignment: size_t = alignof(max_align_t);
    let old_alignment: size_t = alignof(long double);
    let null_value: void* = nullptr;
    let literal: struct point = (struct point){x: 1, y: 2};
    let generic: int = _Generic(pointer_element, int*: 1, default: 0);

    atomic_fetch_add(&atomic_integer, 1);
    atomic_store(&atomic_by_constructor, 2);
    let atomic_value: int = atomic_load(&atomic_by_constructor);

    pointer_to_pointer as void;
    array_pointer as void;
    function_pointer_value as void;
    text as void;
    positive as void;
    logical_not as void;
    bit_not as void;
    distance as void;
    comma as void;
    unevaluated_size as void;
    old_alignment as void;
    null_value as void;
    literal as void;
    generic as void;
    atomic_value as void;
    alignment as void;
    type_size as void;
    expression_size as void;
}

function main(): int
{
    static_assert(sizeof(int) >= 2);
    static_assert(WIDTH > 0, "width must be positive");

    constexpr let local_limit: int = 10;
    let inferred = local_limit + 1;
    let local: int = inferred;
    let matrix: int[local_limit][2];
    matrix[0][0] = 42;

    let operation: int = apply_operation(20, 22, add);
    let collected: int = collect_varargs(3, 1, 2, 3) as int;
    let returned_array: int[4]* = returns_array_pointer();
    takes_callback(callback_body)(7);

    atomic_init(&atomic_integer, 0);
    statement_expressions(inferred);
    expression_productions();

    printf("%d %d %d %d %d %d %s %s\n",
           operation,
           collected,
           returned_array[0][0],
           c23_label_placement(-12),
           local,
           matrix[0][0],
           __func__,
           STRINGIZE(Cx));

    return EXIT_SUCCESS;
}
